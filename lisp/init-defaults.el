;;; Commentary:

;; This file applies reasonable default settings to make the Emacs
;; experience more consistent.

;;; Code:

(require 'init-util)

(require-package 'vertico)
(require-package 'marginalia)
(require-package 'consult)
(require-package 'orderless)
(require-package 'gcmh)

;;;; Tune default settings

;; By default, Emacs asks the user if it should kill processes on exit. VS Code
;; does not do that, and I find it annoying to type "yes" every type, so just
;; let Emacs kill processes automatically.
(setq confirm-kill-processes nil)

;; Also kill buffers which have a running process without confirmation.
(setq kill-buffer-query-functions (delq 'process-kill-buffer-query-function
                                        kill-buffer-query-functions))

;; When deleting a file, always use the system's trash can if possible.
(setq delete-by-moving-to-trash t)

;; Do not show the startup screen. If the `+dashboard' module is enabled, it
;; will provide a beautiful and feature-rich dashboard on startup instead.
(setq inhibit-startup-screen t)

;; Do not report warnings and errors produced by asynchronous native
;; compilation, since they do not matter in most occasions and there is little
;; we can do with warnings generated by third-party packages.
(when (featurep 'native-compile)
  (setq-default native-comp-async-report-warnings-errors nil))

;; Hide commands in M-x which do not apply to the current mode.
(setq read-extended-command-predicate #'command-completion-default-include-p)

;; The default value of `read-process-output-max' (4 kB) is too low considering
;; some language server responses are from 800 kB to 3 MB. So set it to 1 MB as
;; suggested by Lsp-mode.
(setq read-process-output-max (* 1024 1024))

;; Save existing clipboard text into kill ring before replacing it. This saves
;; me so many time!
(setq save-interprogram-paste-before-kill t)

;; Uniquify buffer names in a saner way. See the doc for details.
(setq uniquify-buffer-name-style 'forward)

;; Break lines after CJK characters.
(setq word-wrap-by-category t)

;; Always use space characters for indentation.
(setq-default indent-tabs-mode nil)

;;;; Enable useful minor modes

;; Display column number alongside line number.
(column-number-mode 1)

;; Highlight the current line.
(hl-line-mode 1)

;; Selection can be deleted using DEL or any insertion command, making
;; it consistent with other applications.
(delete-selection-mode 1)

;; Enable repeat-mode to allow repeating commands with a single key.
;; For example, after `C-x o' (other-window), pressing `o' repeatedly
;; cycles through windows without repressing the prefix key.
(repeat-mode 1)

;; Auto insert template contents into newly-created files
(auto-insert-mode 1)

;; Enable key hints by which-key.
(which-key-mode 1)

;; Auto-revert buffers when files change on disk.
(global-auto-revert-mode 1)

;; Truncate long lines in text mode buffers.
(add-hook 'text-mode-hook #'visual-line-mode)

;; Enable garbage collection magick hack provided by gcmh.
(gcmh-mode 1)

;;;; Persist history of files, commands, etc.

;; Persist recent files.
(recentf-mode 1)

;; Persist cursor locations in files.
(save-place-mode 1)

;; Persist variables with `savehist-mode'.
(savehist-mode 1)

;; Savehist only saves minibuffer history by default.  Let it save
;; these variables, too.
(setq-default savehist-additional-variables
	      '(kill-ring
		register-alist
		mark-ring
		global-mark-ring
		search-ring
		regexp-search-ring))


;;;; Tune backup & auto saving

;; Put backup files in a single place.
(setq backup-directory-alist `(("." . ,(locate-user-emacs-file "backup"))))

;; Backup by copying.
(setq backup-by-copying t)

;; Do not print any message when auto-saving.
(setq auto-save-no-message t)

;;;; Tune minibuffer

;; Allow minibuffer commands while in the minibuffer.
(setq enable-recursive-minibuffers t)
;; And show current minibuffer depth.
(minibuffer-depth-indicate-mode 1)

;; Use shorter format string for default value.
(setq minibuffer-default-prompt-format " [%s]")
;; And do not show default value if a user value is being typed.
(minibuffer-electric-default-mode 1)

;; Do not allow the cursor to move inside the minibuffer prompt.
(setq minibuffer-prompt-properties
      '(read-only t cursor-intangible t face minibuffer-prompt))
(add-hook 'minibuffer-setup-hook #'cursor-intangible-mode)

;; Vertico is a lightweight vertical minibuffer completion framework.
(vertico-mode 1)

;; Marginalia shows candidate info in Vertico UI.
(marginalia-mode 1)

;; Indicator of `completing-read-multiple' suggested by Vertico.
(defun zy-minibuffer-crm-indicator (args)
  "Indicator for `completing-read-multiple'.

ARGS are the arguments passed."
  (defvar crm-separator)
  (cons (format "[CRM%s] %s"
                (replace-regexp-in-string
                 "\\`\\[.*?]\\*\\|\\[.*?]\\*\\'" ""
                 crm-separator)
                (car args))
        (cdr args)))
(advice-add #'completing-read-multiple :filter-args
	    #'zy-minibuffer-crm-indicator)

;; Use the orderless completion style, a fuzzy matching style provided
;; by the orderless package.
(setq completion-styles '(basic substring orderless))

;; Define custom dispatchers for orderless.
(zy-eval-after-load 'orderless
  (defun zy-orderless-literal-dispatch (word _index _total)
    "Read WORD= as a literal string."
    (when (string-suffix-p "=" word)
      `(orderless-literal . ,(substring word 0 -1))))

  (defun zy-orderless-initialism-dispatch (word _index _total)
    "Read WORD% as an initialism."
    (when (string-suffix-p "%" word)
      `(orderless-initialism . ,(substring word 0 -1))))

  ;; Add `orderless-flex' to the list of matching styles.
  (setq orderless-matching-styles '(orderless-literal
                                    orderless-regexp
                                    orderless-flex))

  ;; Add my custom dispatchers to the list.
  (setq orderless-style-dispatchers '(zy-orderless-literal-dispatch
                                      zy-orderless-initialism-dispatch
				      orderless-affix-dispatch))

  ;; Fine-tune category-specific completion styles. If Orderless does
  ;; not do good in some categories, just override it.
  (setq completion-category-overrides
	'((file (styles . (basic partial-completion))))))

;;;; Mouse & touchpad interaction

;; Fix horizontal scroll direction.
(setq mouse-wheel-flip-direction t)

;; Enable horizontal scrolling.
(setq mouse-wheel-tilt-scroll t)

;; Enable smooth scrolling.
(pixel-scroll-precision-mode 1)

;;;; Configure personal information

(when (equal user-login-name "zyxir")
  (setq user-full-name "Eric Zhuo Chen"
	user-mail-address "ericzhuochen@outlook.com"))

;;;; Keybindings

;; Disable mouse wheel scaling to prevent accidental activation when
;; using a touchpad.
(keymap-global-unset "C-<wheel-up>")
(keymap-global-unset "C-<wheel-down>")

;; Map both Command (⌘) keys to Super.
(setq ns-command-modifier 'super)
(setq ns-right-command-modifier 'super)

;; Map the left Option (⌥) key to Meta, while leaving the right Option
;; key unchanged.
(setq ns-option-modifier 'meta)
(setq ns-right-option-modifier 'none)

;; Map Function key to Hyper to support more native keybindings.
(setq ns-function-modifier 'hyper)

;; Control+Command+F: toggle fullscreen.
(keymap-global-set "C-s-F" #'toggle-frame-fullscreen)

;; Control+Hyper+F: toggle maximized.
(keymap-global-set "C-H-F" #'toggle-frame-maximized)

;; Command+4: other window prefix.
(keymap-global-set "s-4" #'other-window-prefix)

;; Command+P: smart jumper by `consult-buffer'.
(keymap-global-set "s-p" #'consult-buffer)

;; Command+Shift+P: run command (`M-x').
(keymap-global-set "s-P" #'execute-extended-command)

;; Command+L: goto line interactively
(keymap-global-set "s-l" #'consult-goto-line)

;; Command+Up/Down: beginning/end of buffer.
(keymap-global-set "s-<up>" #'beginning-of-buffer)
(keymap-global-set "s-<down>" #'end-of-buffer)

;; Command+Slash: toggle comment.
(keymap-global-set "s-/" #'comment-dwim)

;; Command+Shift+Z: redo.
(keymap-global-set "s-Z" #'undo-redo)

;; Command+K: leader.
(keymap-global-set "s-k" zy-leader-map)

(provide 'init-defaults)

;;; init-defaults.el ends here
